{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.schift.io/awp/v0.1.json",
  "title": "Agent Workflow Protocol v0.1",
  "type": "object",
  "required": ["schema", "version", "id", "name", "agents", "graph"],
  "properties": {
    "schema": { "const": "agent-workflow-protocol" },
    "version": { "const": "0.1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "inputs": { "$ref": "#/$defs/fields" },
    "outputs": { "$ref": "#/$defs/fields" },
    "state": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/scalarType" },
          { "$ref": "#/$defs/field" }
        ]
      }
    },
    "data_sources": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/dataSource" }
    },
    "input_mapping_contract": { "$ref": "#/$defs/inputMappingContract" },
    "quality_contract": { "$ref": "#/$defs/qualityContract" },
    "output_contract": { "$ref": "#/$defs/outputContract" },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/agent" }
    },
    "tools": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/tool" }
    },
    "policies": { "$ref": "#/$defs/policies" },
    "connectors": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/connector" }
    },
    "tool_calling": { "$ref": "#/$defs/toolCalling" },
    "native": { "$ref": "#/$defs/native" },
    "graph": { "$ref": "#/$defs/graph" },
    "adapters": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/adapter" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "scalarType": {
      "enum": ["string", "number", "integer", "boolean", "object", "array"]
    },
    "field": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/scalarType" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "default": true
      },
      "additionalProperties": true
    },
    "fields": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "model": {
      "type": "object",
      "required": ["provider", "name"],
      "properties": {
        "provider": { "type": "string" },
        "name": { "type": "string" },
        "temperature": { "type": "number" },
        "max_output_tokens": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "type": "string" },
        "model": { "$ref": "#/$defs/model" },
        "instructions": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "connectors": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "type": "string" } },
        "max_steps": { "type": "integer" },
        "tool_choice": { "$ref": "#/$defs/toolChoice" },
        "tool_parallelism": { "$ref": "#/$defs/toolParallelism" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    },
    "tool": {
      "type": "object",
      "required": ["kind", "description"],
      "properties": {
        "kind": { "type": "string" },
        "description": { "type": "string" },
        "schema_format": {
          "enum": ["json_schema", "openapi_schema", "zod_adapter", "mcp_tool"]
        },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "runtime": { "enum": ["local", "schift", "mcp", "http", "adapter"] },
        "execution": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": {
              "enum": ["host", "client", "server", "mcp", "remote", "manual", "adapter"]
            },
            "binding": { "type": "string" },
            "timeout_ms": { "type": "integer" }
          },
          "additionalProperties": true
        },
        "approval": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["none", "always", "conditional", "runtime"] },
            "checkpoint": { "type": "string" },
            "condition": { "type": "string" }
          },
          "additionalProperties": true
        },
        "strict": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "side_effect": { "enum": ["none", "read", "write", "external"] },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    },
    "toolChoice": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["auto", "none", "required", "any", "tool", "validated"] },
        "tool": { "type": "string" },
        "allowed_tools": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "toolParallelism": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "max_concurrent": { "type": "integer" },
        "return_results_together": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "connector": {
      "type": "object",
      "required": ["kind", "source"],
      "properties": {
        "kind": { "type": "string" },
        "source": { "type": "string" },
        "mode": { "enum": ["read", "write", "read_write"] },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "config": { "type": "object" }
      },
      "additionalProperties": true
    },
    "dataSource": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["api", "connector", "file", "inline", "runtime"] },
        "description": { "type": "string" },
        "schema_format": {
          "enum": ["json_schema", "openapi_schema", "zod_adapter", "mcp_tool"]
        },
        "input_schema": { "type": "object" },
        "return_schema": { "type": "object" },
        "api": {
          "type": "object",
          "required": ["endpoint"],
          "properties": {
            "endpoint": { "type": "string", "minLength": 1 },
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "query": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "body_schema": { "type": "object" },
            "auth": { "enum": ["none", "api_key", "bearer", "oauth", "runtime"] },
            "timeout_ms": { "type": "integer", "exclusiveMinimum": 0 }
          },
          "additionalProperties": true
        },
        "cache": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "ttl_seconds": { "type": "integer", "minimum": 0 },
            "key_fields": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "maps_to": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    },
    "policies": {
      "type": "object",
      "properties": {
        "code": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "egress": {
          "type": "object",
          "properties": {
            "require_allowlist": { "type": "boolean" },
            "allowed_domains": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "approvals": {
          "type": "object",
          "properties": {
            "write_requires_approval": { "type": "boolean" },
            "external_requires_approval": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "require_bound_connectors": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "blockingIssue": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "message": { "type": "string", "minLength": 1 },
        "field": { "type": "string" }
      },
      "additionalProperties": true
    },
    "inputMappingContract": {
      "type": "object",
      "required": ["normalized_output"],
      "properties": {
        "raw_fields": { "$ref": "#/$defs/fields" },
        "intent_resolution": {
          "type": "object",
          "properties": {
            "task_kinds": { "type": "array", "items": { "type": "string" } },
            "source_modes": { "type": "array", "items": { "type": "string" } },
            "passage_modes": { "type": "array", "items": { "type": "string" } },
            "missing_inputs": { "type": "array", "items": { "type": "string" } },
            "assumptions": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "defaults": { "type": "object" },
        "clamps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" }
            },
            "additionalProperties": true
          }
        },
        "routing_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "condition", "entry_node", "reason"],
            "properties": {
              "code": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
              "condition": { "type": "string", "minLength": 1 },
              "entry_node": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "blocking_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/blockingIssue" }
        },
        "normalized_output": {
          "type": "object",
          "required": ["normalized_input", "route_decision", "validation"],
          "properties": {
            "normalized_input": { "$ref": "#/$defs/fields" },
            "route_decision": {
              "type": "object",
              "required": ["entry_node"],
              "properties": {
                "awp_id": { "type": "string" },
                "entry_node": { "type": "string", "minLength": 1 },
                "reason": { "type": "string" }
              },
              "additionalProperties": true
            },
            "validation": {
              "type": "object",
              "properties": {
                "blocking_issue_codes": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }
                },
                "assumptions": { "type": "array", "items": { "type": "string" } },
                "user_facing_prompt_fields": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "qualityContract": {
      "type": "object",
      "required": ["mode", "targets"],
      "properties": {
        "mode": { "enum": ["blocking", "advisory"] },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact", "checks"],
            "properties": {
              "artifact": { "type": "string", "minLength": 1 },
              "checks": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "required_evidence": { "type": "array", "items": { "type": "string" } },
        "retry_policy": {
          "type": "object",
          "properties": {
            "normal_attempts": { "type": "integer", "minimum": 0 },
            "agentic_extra_attempts": { "type": "integer", "minimum": 0 },
            "retry_input": { "enum": ["issues_and_suggestions", "failed_artifact", "custom"] },
            "no_graph_cycle": { "const": true }
          },
          "additionalProperties": true
        },
        "result_shape": {
          "type": "object",
          "properties": {
            "score_required": { "type": "boolean" },
            "metrics": { "type": "array", "items": { "type": "string" } },
            "blocking_issue_codes": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }
            },
            "retry_hints_required": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "outputContract": {
      "type": "object",
      "required": ["required_fields"],
      "properties": {
        "required_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_metadata": { "type": "array", "items": { "type": "string" } },
        "include_qc_summary": { "type": "boolean" },
        "include_usage": { "type": "boolean" },
        "include_protocol_metadata": { "type": "boolean" },
        "blocking_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/blockingIssue" }
        }
      },
      "additionalProperties": true
    },
    "native": {
      "type": "object",
      "properties": {
        "token_counter": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "fields": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "logging": {
          "type": "object",
          "properties": {
            "level": { "enum": ["debug", "info", "warn", "error"] },
            "events": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "streaming": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "persist_deltas": { "type": "boolean" },
            "include_text_deltas": { "type": "boolean" },
            "include_tool_call_deltas": { "type": "boolean" },
            "snapshot_interval_ms": { "type": "integer" }
          },
          "additionalProperties": true
        },
        "structured_output": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "mode": { "enum": ["json_schema", "tool_result", "adapter"] },
            "schema": { "type": "object" }
          },
          "additionalProperties": true
        },
        "reasoning": {
          "type": "object",
          "properties": {
            "capture": { "enum": ["none", "provider_summary", "redacted_trace", "metadata_only"] },
            "include_raw_thinking": { "const": false },
            "summary_required": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "audit": {
          "type": "object",
          "properties": {
            "checkpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "type"],
                "properties": {
                  "id": { "type": "string" },
                  "type": { "type": "string" },
                  "required": { "type": "boolean" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "toolCalling": {
      "type": "object",
      "properties": {
        "default_choice": { "$ref": "#/$defs/toolChoice" },
        "parallelism": { "$ref": "#/$defs/toolParallelism" },
        "require_results_for_all_calls": { "type": "boolean" },
        "mint_protocol_call_id": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["chat_trigger", "manual_trigger", "schedule_trigger", "webhook_source", "gmail_trigger", "notion_trigger", "agent", "aggregate", "tool", "connector", "code", "data_source", "validate", "guard", "qc", "router", "join", "state", "human_approval", "subworkflow", "end"]
        },
        "ref": { "type": "string" },
        "label": { "type": "string" },
        "stage": { "type": "integer", "minimum": 0 },
        "parallel_group": { "type": "string", "minLength": 1 },
        "config": { "type": "object" }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "condition": { "type": "string" },
        "label": { "type": "string" }
      },
      "additionalProperties": true
    },
    "graph": {
      "type": "object",
      "required": ["start", "nodes", "edges"],
      "properties": {
        "start": { "type": "string" },
        "execution": {
          "type": "object",
          "properties": {
            "max_concurrency": { "type": "integer", "minimum": 1 },
            "stage_policy": { "enum": ["auto", "explicit"] },
            "aggregate_policy": { "enum": ["all_settled", "fail_fast"] }
          },
          "additionalProperties": true
        },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        }
      },
      "additionalProperties": true
    },
    "adapter": {
      "type": "object",
      "properties": {
        "target": { "type": "string" },
        "status": { "enum": ["direct", "requires_runtime", "unsupported", "planned"] },
        "runtime": { "enum": ["schift", "host", "provider", "reference"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
