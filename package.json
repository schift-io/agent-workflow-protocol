{
  "name": "@schift-io/agent-workflow-protocol",
  "version": "0.1.1",
  "description": "AWP: a YAML-first protocol for portable agent workflows.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schift-io/agent-workflow-protocol.git"
  },
  "homepage": "https://github.com/schift-io/agent-workflow-protocol#readme",
  "bugs": {
    "url": "https://github.com/schift-io/agent-workflow-protocol/issues"
  },
  "bin": {
    "awp": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "schemas",
    "spec",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "agent",
    "workflow",
    "protocol",
    "yaml",
    "awp",
    "langgraph",
    "vercel-ai-sdk"
  ],
  "author": "Schift <hello@schift.io>",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
